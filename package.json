{
  "name": "cursorrepo-calendar",
  "version": "1.0.0",
  "description": "A calendar web app for viewing daily events, with an agent-friendly MCP server so Claude/ChatGPT can view and manage the calendar.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "mcp": "node src/mcp-server.js",
    "mcp:http": "node src/mcp-server.js --http",
    "test": "jest --runInBand",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.19.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
